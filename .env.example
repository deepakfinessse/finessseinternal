# Copy to .env.local and fill in. This file is committed — keep it free of real secrets.

# Session / JWT encryption key (required). Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth 2.0 Web client credentials (required).
# Google Auth Platform > Clients > Create client > Web application.
#   Authorized JavaScript origin:  http://localhost:3000
#   Authorized redirect URI:       http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google Workspace domain permitted to sign in. Bare domain only (matched
# against Google's `hd` claim, not a URL).
GOOGLE_WORKSPACE_DOMAIN=finessse.digital

# MongoDB connection (required).
#   Local:  mongodb://127.0.0.1:27017
#   Atlas:  mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=finesssepm

# Comma-separated emails granted Super Admin on first sign-in. The very first
# account to sign in always bootstraps as Super Admin regardless of this list.
RBAC_BOOTSTRAP_EMAILS=

# SMTP for invitation email. Optional in dev: when unset, the invite link is
# shown in the UI and logged to the server console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=Finessse <no-reply@finessse.digital>

# Reported as the running version on the Sessions page.
APP_VERSION=0.1.0

# Canonical site URL in production (used for invitation links & OAuth).
# AUTH_URL=
